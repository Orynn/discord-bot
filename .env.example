DISCORD_TOKEN=TOKEN_HERE
# Optional. Anonymous Pollinations still works; a key raises the quota.
# POLLINATIONS_API_KEY=
# Optional. Copy each SQLite snapshot to this folder (USB, NAS, other disk).
# ARKANN_BACKUP_REMOTE=/mnt/backup/arkann
# Optional. Public URL for the combat board (reverse-proxy with auth).
# Defaults to 127.0.0.1 — do not bind 0.0.0.0 without a token-aware proxy.
# ARKANN_EDITOR_URL=https://arkann.example.com
# ARKANN_EDITOR_HOST=127.0.0.1
# ARKANN_EDITOR_PORT=8765
# Optional. Free key from https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
